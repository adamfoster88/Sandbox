# App Configuration
DEBUG=true
FRONTEND_URL=http://localhost:5173

# Azure AD Authentication (get from Azure Portal > App Registration)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Azure Blob Storage (get from Azure Portal > Storage Account > Access Keys)
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account
AZURE_STORAGE_ACCOUNT_KEY=your-storage-key
AZURE_STORAGE_CONNECTION_STRING=your-connection-string

# SQL Server (your existing SQL Server connection details)
SQL_SERVER_HOST=your-server.database.windows.net
SQL_SERVER_DATABASE=your-database
SQL_SERVER_USER=your-username
SQL_SERVER_PASSWORD=your-password
